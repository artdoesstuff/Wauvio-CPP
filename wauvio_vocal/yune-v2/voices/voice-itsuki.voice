style legato 0.73
style attack_sharpness 0.4
style release 0.64000005
style volume 1
style velocity_response 0.65
style compression 0.3
style dynamic_timbre 0.6
style formant_shift 0
style mouth_open 0
style growl 0
style tremor 0
style tremor_rate 9
style fry 0
style air 0.080000006
style reg 0.080000006
style reg_auto 0
style glottal_onset 0
style pitch_loud 0
style pitch_snap 0
style undershoot 0
style porta_interval 0
style exit_fall_min 0.2
style bidakuon 0
style n_nasalize 0
style mumble 0.08
style transition_speed 1
style vv_glide 0
style devoice_max 0.11
style mora_weighting 0
style glottal_final 0
style grit 0.55
style natural 0
style devoicing 1

# lyric parsing
parse merge_long_vowels 1
parse cute 0

