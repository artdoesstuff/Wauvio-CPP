# Wauvio voice profile. Every value is explicit; edit and load with load_profile().
voice itsuki
display Itsuki (樹)
language ja
notes Deep, resonant, smooth male voice: rounded vowels, controlled vibrato, grainy when pushed; dark and restrained.
natural_amount 0.5

# model
model_name Itsuki: deep, resonant Japanese male
range 41 67 36 76
vowel a 730 1184 2580 124 120 175 1 0.85 0
vowel i 274 2280 3010 87 138 184 1 0.45 0
vowel u 307 1160 2365 92 115 166 1 0.45 0
vowel e 465 1960 2752 101 124 175 1 0.75 0
vowel o 473 784 2408 101 110 166 1 0.75 0
model f4 3600
model f5 4600
model f6 5900
model b4 230
model b5 290
model b6 430
model singer_formant_hz 2750
model singer_formant_bw 520
model rd_base 0.95
model aspiration 0.016
model tilt_hz_min 1900
model tilt_hz_max 8000
model vib_depth_st 0.24
model vib_rate_hz 5.3
model vib_delay 0.4
model vib_fade 0.45
model synthetic 0.5
tune out_scale 0.7
tune asp_gain 2.6
tune fric_gain 0.3
tune upper_gain 1.4
tune sing_gain 1.8
tune air_gain 0.06
tune pre_gain 1
tune f23_gain 26

# default style (the character's Normal look)
style brightness 0.45
style breathiness 0.144
style tension 0.38599998
style softness 0.4
style power 0.43
style resonance 0.56
style femininity 0.5
style vibrato_depth 0.228
style vibrato_rate 5.523158
style vibrato_delay 0.45333335
style vibrato_fade -1
style portamento 0.094000004
style pitch_response 0.45
style overshoot 0.14
