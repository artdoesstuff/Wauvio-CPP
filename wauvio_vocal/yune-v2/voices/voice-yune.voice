# Wauvio voice profile. Every value is explicit; edit and load with load_profile().
voice yune
display Yune (夢音)
language ja
notes Bright, clear Japanese female singing voice; peripheral vowels for clarity, tight resonances.
natural_amount 0.6

# model
model_name Yune: Japanese default female voice
range 52 88 40 96
vowel a 880 1480 3000 135 130 190 1 0.85 0
vowel i 330 2850 3500 95 150 200 1 0.45 0
vowel u 370 1450 2750 100 125 180 1 0.45 0
vowel e 560 2450 3200 110 135 190 1 0.75 0
vowel o 570 980 2800 110 120 180 1 0.75 0
model f4 4300
model f5 5600
model f6 7200
model b4 260
model b5 320
model b6 500
model singer_formant_hz 3100
model singer_formant_bw 600
model rd_base 0.95
model aspiration 0.02
model tilt_hz_min 2600
model tilt_hz_max 11000
model vib_depth_st 0.32
model vib_rate_hz 5.7
model vib_delay 0.3
model vib_fade 0.35
model synthetic 0.65
tune out_scale 0.65
tune asp_gain 3
tune fric_gain 0.3
tune upper_gain 2
tune sing_gain 2
tune air_gain 0.1
tune pre_gain 1
tune f23_gain 30

# default style (the character's Normal look)
style brightness 0.78
style breathiness 0.2
style tension 0.42
style softness 0.35
style power 0.35
style resonance 0.55
style femininity 0.58
style vibrato_depth 0.3
style vibrato_rate 6
style vibrato_delay 0.35
style vibrato_fade -1
style portamento 0.09
style pitch_response 0.55
style overshoot 0.25
style scoop 0.45
style exit_fall 0.2
style drift 0
style micro 0
style consonant_strength 0.5
style consonant_duration 1
style vowel_clarity 0.6
style legato 0.6
style attack_sharpness 0.5
style release 0.55
style volume 1
style velocity_response 0.65
style compression 0.3
style dynamic_timbre 0.5
style formant_shift 0.6
style mouth_open 0
style growl 0
style tremor 0
style tremor_rate 9
style fry 0
style air 0.1
style reg 0.1
style reg_auto 0
style glottal_onset 0
style pitch_loud 0
style pitch_snap 0
style undershoot 0
style porta_interval 0
style exit_fall_min 0.2
style bidakuon 0
style n_nasalize 0
style mumble 0
style transition_speed 1
style vv_glide 0
style devoice_max 0.11
style mora_weighting 0
style glottal_final 0
style grit 0
style natural 0
style devoicing 1

# lyric parsing
parse merge_long_vowels 1
parse cute 0

